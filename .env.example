# Public: identifies the Sanity project (safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: canonical origin for sitemap/robots/metadata/hreflang. Defaults to the Vercel
# production domain, then http://localhost:3000. Production: https://previewly-wheat.vercel.app
# NEXT_PUBLIC_SITE_URL=https://previewly-wheat.vercel.app

# Server-only. Viewer role: reads drafts for preview and validates preview secrets.
# Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only. Shared secret for the publish webhook's HMAC signature (/api/revalidate).
SANITY_REVALIDATE_SECRET=

# Local only (seed script), never deployed. Administrator role on the Free plan.
SANITY_API_EDITORIAL_TOKEN=
